# Server-side ORS API key. Used by the proxy core in server/ors-proxy.js, which
# backs both the dev-time middleware (vite/ors-proxy.js) and the Vercel
# functions (api/ors/). It is never sent to the browser.
# On Vercel, set the same variable in Project Settings > Environment Variables.
# Get one at https://openrouteservice.org/dev/#/signup
OPENROUTESERVICE_API_KEY=replace-me
